[data-name=xaxis] { font-size: 0.8em }
.pdl-layout > div[data-type=layout]
  display: grid
  grid-template-columns: 1fr fit-content(10em)
  grid-template-rows: 1fr fit-content(2em)
  /* 0.5em: 軸兩端的刻度文字不被切掉 */
  padding: 0 0.5em
  & > .pdl-cell[data-name=view] { grid-area: 1 / 1 }
  & > .pdl-cell[data-name=xaxis] { grid-area: 2 / 1 }
  & > .pdl-cell[data-name=legend]
    grid-area: 1 / 2 / span 2
    padding-left: 1em

.pdl-layout.legend-bottom > div[data-type=layout]
  grid-template-columns: 1fr
  grid-template-rows: 1fr fit-content(2em) fit-content(3em)
  & > .pdl-cell[data-name=legend]
    grid-area: 3 / 1
    padding: 1em 0 0

.pdl-layout.no-xaxis > div[data-type=layout] > .pdl-cell[data-name=xaxis]
  display: none
